# TravelMind AI Environment Configuration

# System Mode
DEMO_MODE=false

# Database
POSTGRES_DB=travelmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=sqlite:///./travelmind.db

# Cache (Docker service name)
REDIS_URL=redis://redis:6379/0

# Security / Authentication
JWT_SECRET_KEY=super-secret-key-travelmind-ai-2026-production-grad
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External AI & Weather APIs (Optional in DEMO_MODE)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
WEATHER_API_KEY=

# Service Internal Routing URLs (Docker Container Service Names)
USER_SERVICE_URL=http://user-service:8000
TRIP_SERVICE_URL=http://trip-service:8000
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000
AI_SERVICE_URL=http://ai-service:8000
PREDICTION_SERVICE_URL=http://prediction-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
